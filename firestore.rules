rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function hasAny(keys) {
      return request.resource.data.diff(resource == null ? {} : resource.data).changedKeys().hasAny(keys);
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !hasAny(['venue', 'reception_venue', 'venue_vendor_id', 'venue_address', 'venue_set_at']) || isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !hasAny(['venue', 'reception_venue', 'venue_vendor_id', 'venue_address', 'venue_set_at']) || isAdmin();
    }

    // --- Livre d'Or (Sprint Novembre 2026 - Adnane) ---
    match /guestbooks/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.resource.data.owner_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /guestbook_entries/{entryId} {
      allow read: if isSignedIn() && (resource.data.owner_id == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.owner_id == request.auth.uid || isAdmin());
      // Écriture invité : uniquement via API route (adminDb) avec validation du public_token
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
